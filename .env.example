# Скопируйте этот файл в .env и заполните своими значениями

# --- API ---
API_URL=https://api.itresume.ru/statistics/
API_CLIENT=Skillfactory
API_CLIENT_KEY=ключ_из_задания
API_CHUNK_HOURS=6
API_TIMEOUT=120

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=grader
DB_USER=postgres
DB_PASSWORD=your_password

# --- Логи ---
LOG_DIR=logs
LOG_KEEP_DAYS=3

# --- Google Sheets (доп. задание 1) ---
GSHEETS_ENABLED=false
GSHEETS_CREDENTIALS=credentials.json
GSHEETS_SPREADSHEET=ключ_таблицы_из_URL
GSHEETS_WORKSHEET=daily_stats

# --- Почта (доп. задание 2) ---
EMAIL_ENABLED=false
SMTP_SERVER=smtp.mail.ru
SMTP_PORT=465
EMAIL_SENDER=your_box@mail.ru
EMAIL_PASSWORD=пароль_для_внешних_приложений
EMAIL_RECIPIENTS=boss@example.com,me@example.com
EMAIL_ATTACH_LOG=true
